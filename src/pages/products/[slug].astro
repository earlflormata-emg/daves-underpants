---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import data from '../../data/products.json';

// Storefront-ready: one static route per product. When you move to live selling,
// swap the "Join the List" block for an add-to-cart / checkout (GHL order form,
// Shopify headless Buy Button, or Stripe Checkout).
export function getStaticPaths() {
  return data.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---
<BaseLayout title={`${product.name} — ${data.brand.name}`} description={product.tagline}>
  <section class="pdp">
    <div class="container pdp__grid">
      <div class="pdp__media">
        <img src={product.image} alt={product.name} width="700" height="700" />
        {product.badge && <span class="badge pdp__badge">{product.badge}</span>}
      </div>

      <div class="pdp__info">
        <a class="pdp__back" href="/#drop">← Back to the drop</a>
        <h1 class="pdp__name">{product.name}</h1>
        <p class="pdp__tag">{product.tagline}</p>
        <p class="pdp__price">${product.price}</p>

        <p class="pdp__desc">{product.description}</p>

        <div class="pdp__sizes">
          <span class="pdp__label">Size</span>
          <div class="pdp__chips">
            {product.sizes.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>

        <ul class="pdp__meta">
          <li>✓ {data.brand.fabric}</li>
          <li>✓ {data.brand.shipping}</li>
          <li>✓ {data.brand.returnsPolicy}</li>
        </ul>

        <div class="pdp__cta">
          <p class="pdp__ctaline">Not on sale yet — join the list to get it first:</p>
          <WaitlistForm variant="light" />
        </div>
        <p class="pdp__care"><strong>Care:</strong> {product.care}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pdp { padding: 40px 0 20px; }
  .pdp__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 42px; align-items: start; }
  .pdp__media { position: relative; border-radius: 20px; overflow: hidden; background: #f4f4f6; }
  .pdp__media img { width: 100%; height: auto; }
  .pdp__badge { position: absolute; top: 14px; left: 14px; }
  .pdp__back { color: #888; font-size: 14px; }
  .pdp__back:hover { color: var(--pop); }
  .pdp__name { font-size: clamp(30px, 5vw, 44px); margin: 12px 0 4px; letter-spacing: -.02em; }
  .pdp__tag { color: var(--ink-soft); font-size: 18px; }
  .pdp__price { font-weight: 800; font-size: 24px; margin: 12px 0; }
  .pdp__desc { color: #444; margin-bottom: 20px; }
  .pdp__label { font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: #777; }
  .pdp__chips { display: flex; gap: 8px; margin: 8px 0 20px; flex-wrap: wrap; }
  .chip { border: 1.5px solid var(--ink); border-radius: 8px; padding: 8px 14px; font-weight: 700; font-size: 14px; }
  .pdp__meta { list-style: none; color: #555; font-size: 14px; margin-bottom: 22px; display: grid; gap: 6px; }
  .pdp__cta { border-top: 1px solid var(--line); padding-top: 20px; }
  .pdp__ctaline { margin-bottom: 12px; font-weight: 600; }
  .pdp__cta :global(.wl) { margin: 0; }
  .pdp__care { color: #999; font-size: 13px; margin-top: 16px; }
  @media (max-width: 820px) { .pdp__grid { grid-template-columns: 1fr; gap: 24px; } }
</style>
