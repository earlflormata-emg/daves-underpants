---
import WaitlistForm from './WaitlistForm.astro';
import data from '../data/products.json';
---
<section class="hero" id="join">
  <div class="container hero__inner">
    <img class="hero__logo rise" src="/images/logo.jpg" alt={data.brand.name} width="180" height="180" />
    <span class="kicker rise">Coming Soon</span>
    <h1 class="hero__title rise rise-2">{data.brand.tagline}</h1>
    <p class="hero__sub rise rise-3">
      We're putting the finishing touches on the most ridiculous boxer briefs you'll ever be
      proud to wear. Drop your email and be first in line when they drop.
    </p>
    <div class="rise rise-3">
      <WaitlistForm variant="light" />
      <p class="hero__trust">No spam. Just one very exciting email when we launch.</p>
    </div>
  </div>
  <div class="hero__glow" aria-hidden="true"></div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: 64px 0 40px; }
  .hero__inner { position: relative; z-index: 1; text-align: center; max-width: 820px; }
  .hero__logo { width: 164px; height: auto; margin: 0 auto 14px; border-radius: 18px; }
  .hero__title { font-size: clamp(34px, 7vw, 58px); line-height: 1.02; letter-spacing: -.02em; margin: 14px 0; }
  .hero__sub { font-size: 19px; color: var(--ink-soft); max-width: 640px; margin: 0 auto 26px; }
  .hero__trust { text-align: center; color: #888; font-size: 13px; margin-top: 12px; }
  .hero__glow {
    position: absolute; inset: -40% 0 auto 0; height: 520px; z-index: 0;
    background: radial-gradient(60% 60% at 50% 0%, rgba(123,47,247,.14), transparent 70%),
                radial-gradient(40% 40% at 80% 10%, rgba(0,194,168,.12), transparent 70%);
    pointer-events: none;
  }
</style>
